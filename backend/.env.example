PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=PROFESOR
DB_USER=sa
DB_PASSWORD=TuPasswordFuerte123
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

JWT_SECRET=CAMBIAR_ESTA_CLAVE_SUPER_SEGURA
JWT_EXPIRES_IN=8h
OPENAI_API_KEY=
OPENAI_EVAL360_MODEL=gpt-4.1-mini
OPENAI_EVAL360_EXAM_MODEL=gpt-5.4
OPENAI_EVAL360_MAX_OUTPUT_TOKENS=16000
OPENAI_PLANEAMIENTO_MODEL=gpt-4.1-mini

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=profe360

EMAIL_SIMULATION=true
WHATSAPP_SIMULATION=true

# WhatsApp para seguimiento diario (Eval360)
# Modo:
# - simulado (default): solo registra en logs, no envía.
# - webhook: realiza POST al endpoint configurado.
WHATSAPP_MODE=simulado
# Proveedor: generic | 2chat | 2chat-waba
WHATSAPP_PROVIDER=generic
# Si está vacío, 2Chat usa automáticamente su endpoint oficial según el proveedor.
WHATSAPP_WEBHOOK_URL=
# Si tu webhook requiere token, configurá aquí. Puede ser valor crudo o "Bearer <token>".
WHATSAPP_WEBHOOK_TOKEN=
# API Key global de 2Chat. Se utiliza para todos los canales e instituciones.
# Si se deja vacía, temporalmente se usa WHATSAPP_WEBHOOK_TOKEN por compatibilidad.
WHATSAPP_2CHAT_API_KEY=
# Página de 2Chat donde el SUPER_ADMIN completa el alta WABA con Meta.
WHATSAPP_2CHAT_WABA_ONBOARDING_URL=https://app.2chat.io/
# Header de autenticación para el token. Default: Authorization
WHATSAPP_WEBHOOK_AUTH_HEADER=Authorization
# Número conectado en 2Chat (obligatorio cuando WHATSAPP_PROVIDER=2chat)
WHATSAPP_FROM_NUMBER=

# Configuración para WABA en 2Chat.
# template (recomendado): requiere una plantilla aprobada por Meta fuera de la ventana de 24 h.
# session: solo texto libre cuando el destinatario abrió una conversación en las últimas 24 h.
WHATSAPP_WABA_MESSAGE_MODE=template
WHATSAPP_WABA_TEMPLATE_UUID=
# Opcional. Por defecto envía el mensaje generado como {{1}}. Ejemplo: ["Nombre", "Detalle"]
WHATSAPP_WABA_TEMPLATE_BODY_PARAMS_JSON=

RESEND_MAX_RETRIES=3
RESEND_RETRY_BASE_DELAY_MS=1000
RESEND_BATCH_SIZE=100
RESEND_WEBHOOK_SIGNING_SECRET=
