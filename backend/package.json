{
  "name": "profe360-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de Profe360 - plataforma web académica multiinstitución",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
