    "seed": "tsx src/seed.ts",
    "db:init": "node scripts/init-db.js"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
